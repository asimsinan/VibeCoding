{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview",
      "node": "20.10.0",
      "env": {
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "npm_config_legacy_peer_deps": "true"
      },
      "channel": "production",
      "node": "20.10.0"
    }
  },
  "submit": {
    "production": {}
  }
}

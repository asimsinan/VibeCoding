{
  "name": "kanban",
  "version": "1.0.0",
  "description": "Kanban Project Management Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:contract": "jest --testPathPattern=tests/api/contract",
    "test:api": "jest --testPathPattern=tests/api",
    "test:api:integration": "jest --testPathPattern=tests/api/integration",
    "test:api:performance": "jest --testPathPattern=tests/api/performance",
    "test:api:security": "jest --testPathPattern=tests/api/security",
    "test:platform": "jest --testPathPattern=tests/platform",
    "test:accessibility": "jest --testPathPattern=tests/accessibility",
    "test:responsive": "jest --testPathPattern=tests/responsive",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write --list-different",
    "analyze": "ANALYZE=true npm run build",
    "bundle:analyze": "npm run build && npx @next/bundle-analyzer",
    "bundle:report": "node scripts/analyze-bundle.js",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "perf:audit": "npm audit --audit-level moderate",
    "perf:monitor": "npm run dev -- --experimental-https",
    "cli": "tsx src/cli/index.ts",
    "cli:json": "tsx src/cli/index.ts json",
    "api-docs": "tsx src/cli/index.ts api-docs",
    "api-docs:html": "tsx src/cli/index.ts api-docs --format html",
    "api-docs:markdown": "tsx src/cli/index.ts api-docs --format markdown",
    "api-docs:json": "tsx src/cli/index.ts api-docs --format json",
    "generate-openapi": "tsx src/cli/index.ts generate-openapi",
    "generate-openapi:json": "tsx src/cli/index.ts generate-openapi --format json",
    "generate-openapi:yaml": "tsx src/cli/index.ts generate-openapi --format yaml",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.1.0",
    "@heroicons/react": "^2.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@next/bundle-analyzer": "^15.5.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "axios": "^1.12.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "intersection-observer": "^0.12.2",
    "js-yaml": "^4.1.0",
    "next": "^15.0.0",
    "openapi-types": "^12.1.3",
    "react": "^18.3.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "requestidlecallback-polyfill": "^1.0.2",
    "resize-observer-polyfill": "^1.5.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.4.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.0",
    "prettier": "^3.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

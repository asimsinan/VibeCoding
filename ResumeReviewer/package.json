{
  "name": "resume-reviewer",
  "version": "1.0.0",
  "description": "AI-powered resume reviewer app with Next.js, TypeScript, Tailwind CSS, Google Gemini API, and Vercel Blob",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest src/tests/contract",
    "test:integration": "jest src/tests/integration",
    "test:unit": "jest src/tests/models",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:performance": "lighthouse-ci autorun",
    "test:security": "npm audit",
    "test:a11y": "jest tests/a11y",
    "db:test-connection": "node scripts/test-db-connection.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@prisma/client": "^5.6.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vercel/blob": "^0.15.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "next": "^14.0.0",
    "openai": "^6.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/react": "^4.8.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.8.0",
    "@types/supertest": "^2.0.16",
    "axe-core": "^4.8.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "lighthouse-ci": "^1.13.1",
    "prettier": "^3.0.3",
    "prisma": "^5.6.0",
    "supertest": "^6.3.3",
    "swagger-cli": "^4.0.4",
    "tailwindcss": "^3.3.0",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

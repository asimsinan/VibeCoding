{
  "name": "zuumcuk",
  "version": "1.0.0",
  "description": "Zuumcuk video conferencing web application with WebRTC, WebSocket, and real-time chat",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "vercel-build": "next build",
    "test": "jest --config jest.config.mjs",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:coverage": "jest --config jest.config.mjs --coverage",
    "test:e2e": "playwright test",
    "test:contract": "jest --config jest.contract.config.mjs",
    "test:integration": "jest --config jest.config.mjs --testPathPattern=integration",
    "test:unit": "jest --config jest.config.mjs --testPathPattern=unit",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/setup-supabase.js",
    "db:setup-fixed": "node scripts/setup-supabase-fixed.js",
    "db:check": "node scripts/check-schema.js",
    "redis:test": "node scripts/test-redis.js",
    "type-check": "tsc --noEmit",
    "websocket": "node websocket-server.cjs",
    "dev:full": "concurrently \"npm run websocket\" \"npm run dev\""
  },
  "keywords": [
    "video-conferencing",
    "webrtc",
    "websocket",
    "real-time",
    "chat"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^9.0.8",
    "@upstash/redis": "^1.35.5",
    "autoprefixer": "^10.0.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "immer": "^10.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.0.0",
    "pg": "^8.0.0",
    "postcss": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.8.0",
    "redis": "^4.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "webrtc-adapter": "^8.2.0",
    "ws": "^8.0.0",
    "zod": "^3.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/axios": "^0.14.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.9",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.0",
    "@types/redis": "^4.0.10",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^6.0.3",
    "@types/webrtc": "^0.0.47",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.4",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.56.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.4"
  }
}

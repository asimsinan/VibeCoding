{
  "name": "collaborative-whiteboard-app",
  "version": "1.0.0",
  "description": "Real-time collaborative whiteboard with drawing and sticky notes",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "dredd contracts/openapi.yaml http://localhost:3000/api/v1 --reporter=spec",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:contract && npm run test:integration && npm run test:e2e",
    "type-check": "tsc --noEmit",
    "cli": "tsx src/cli/whiteboard-cli.ts",
    "cli:build": "tsc src/cli/whiteboard-cli.ts --outDir dist/cli --target es2020 --module commonjs --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports",
    "setup-db": "node setup-database.js",
    "fix-db": "node fix-database.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@supabase/supabase-js": "^2.38.0",
    "@types/commander": "^2.12.0",
    "autoprefixer": "^10.4.16",
    "commander": "^14.0.1",
    "fabric": "^5.5.2",
    "next": "^14.0.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.5.0",
    "tailwindcss": "^3.3.0",
    "undo-manager": "^1.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/fabric": "^5.3.10",
    "@types/jest": "^29.5.5",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@types/supertest": "^2.0.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dredd": "^14.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "supertest": "^6.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "crowdfunding-platform",
  "version": "1.0.0",
  "description": "Crowdfunding platform with Next.js, TypeScript, and PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "dev:api": "PORT=3001 npx ts-node --project tsconfig.backend.json src/server.ts",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "next build",
    "build:api": "tsc --project tsconfig.backend.json",
    "build:full": "npm run build:api && npm run build",
    "start": "next start",
    "start:api": "PORT=3001 node dist/server.js",
    "start:full": "concurrently \"npm run start:api\" \"npm run start\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "jest --testPathPattern=tests/ui",
    "test:visual": "playwright test",
    "test:visual:ui": "playwright test --ui",
    "test:performance": "jest --testPathPattern=tests/performance",
    "test:a11y": "jest --testPathPattern=tests/accessibility",
    "test:security": "npm audit && jest --testPathPattern=tests/security",
    "db:test-connection": "node scripts/test-db-connection.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .next coverage",
    "prepare": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "5.7.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "clsx": "^2.1.1",
    "express-async-handler": "^1.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsonwebtoken": "9.0.2",
    "next": "14.0.0",
    "pg": "8.11.3",
    "playwright": "^1.56.1",
    "prisma": "5.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.3.0",
    "winston": "^3.18.3",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.8",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.10.0",
    "@types/pg": "8.10.9",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "eslint": "8.55.0",
    "eslint-config-next": "14.0.0",
    "express": "4.18.2",
    "helmet": "7.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7.0",
    "morgan": "1.10.0",
    "postcss": "8.4.32",
    "supertest": "6.3.3",
    "tailwindcss": "3.4.0",
    "ts-jest": "29.1.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
